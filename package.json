{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node18 --packages=external --outfile=server.js",
    "build:deploy": "npm run build && npm run build:server && rm -f deploy.zip && zip -r deploy.zip dist server.js package.json package-lock.json",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
