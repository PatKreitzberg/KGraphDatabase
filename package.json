    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "katex": "^0.18.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
